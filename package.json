{
  "name": "context-cortex",
  "version": "0.2.0",
  "private": true,
  "description": "A capability layer for AI: experiments on local programs become checked, transferable skills. MCP server and CLI.",
  "type": "module",
  "bin": {
    "cortex": "bin/cortex.js"
  },
  "exports": {
    ".": "./src/cortex.js",
    "./mcp": "./src/mcp.js"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" && node scripts/check-schemas.mjs",
    "check": "node scripts/check-schemas.mjs",
    "mcp": "node bin/cortex.js mcp",
    "example": "node scripts/make-example.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
