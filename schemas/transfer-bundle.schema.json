{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rossbuckley1990-hash/context-cortex/schemas/transfer-bundle.schema.json",
  "title": "Transfer bundle, draft 0",
  "description": "Skills, the claims they depend on and evidence digests, exported for another model or environment. Import always revalidates; a bundle never carries authority. See docs/ARCHITECTURE.md section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exportedAt", "exportedBy", "sourceEnvironment", "skills", "claims", "artefacts", "carriesAuthority", "importPolicy"],
  "properties": {
    "schema": { "const": "context-cortex/transfer-bundle/v0" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "exportedBy": { "$ref": "common.schema.json#/$defs/actor" },
    "sourceEnvironment": { "$ref": "common.schema.json#/$defs/environment" },
    "skills": { "type": "array", "minItems": 1, "items": { "$ref": "skill.schema.json" } },
    "claims": { "type": "array", "items": { "$ref": "affordance-claim.schema.json" } },
    "artefacts": {
      "description": "Witnesses, adapters, generators and fixtures, each pinned by digest and labelled with its origin.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest", "origin", "role", "path"],
        "properties": {
          "id": { "type": "string" },
          "digest": { "$ref": "common.schema.json#/$defs/digest" },
          "origin": { "$ref": "common.schema.json#/$defs/origin" },
          "role": { "enum": ["witness", "adapter", "generator", "fixture"] },
          "mediaType": { "type": "string" },
          "path": { "description": "Location inside the bundle.", "type": "string" }
        }
      }
    },
    "evidence": {
      "description": "Ledger entries by digest. Raw trial data is optional and stays outside the bundle by default.",
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ledgerRef" }
    },
    "carriesAuthority": {
      "description": "Always false. The importer's own grant decides what may run.",
      "const": false
    },
    "importPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireRevalidation", "initialStatus"],
      "properties": {
        "requireRevalidation": { "const": true },
        "initialStatus": { "const": "imported-unvalidated" }
      }
    },
    "notes": { "type": "string" }
  }
}
