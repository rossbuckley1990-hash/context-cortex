{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rossbuckley1990-hash/context-cortex/schemas/common.schema.json",
  "title": "Context Cortex shared definitions, draft 0",
  "$defs": {
    "digest": {
      "description": "A content digest. Every artefact, input, output and program is referred to by digest.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capabilityRef": {
      "description": "A RightClick X capability id, for example cli:cwebp:png-to-webp or goal:destination-brief.",
      "type": "string",
      "minLength": 1
    },
    "claimState": {
      "description": "Decided only by the engine from ledger evidence. Planning uses established claims only.",
      "enum": ["hypothesised", "observed", "established", "contradicted", "stale"]
    },
    "effectClass": {
      "description": "What running a capability can change. 'unknown' is planned as 'destructive' and runs only in the sandbox.",
      "enum": ["none", "sandbox-write", "host-read", "host-write", "network", "destructive", "unknown"]
    },
    "origin": {
      "description": "Who supplied an artefact or witness. Assurance labels name it. 'acquired' is a capability whose own exactness is established, used as a witness (a decoder witnessing an encoder).",
      "enum": ["built-in", "acquired", "model-authored", "operator-supplied", "imported"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["model", "engine", "operator", "evaluator"] },
        "id": { "type": "string", "minLength": 1 },
        "model": { "description": "Model id, when kind is model.", "type": "string" },
        "session": { "type": "string" }
      }
    },
    "programPin": {
      "description": "A program identity. A changed digest makes every claim about the program stale.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "version": { "type": "string" },
        "package": { "type": "string" }
      }
    },
    "ledgerRef": {
      "description": "One trial in the append-only evidence ledger.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trial", "digest"],
      "properties": {
        "trial": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "witnessRef": {
      "description": "A validator or decoder whose verdicts count only once it is calibrated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "digest", "calibration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "digest": { "$ref": "#/$defs/digest" },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "referencesAccepted", "mutationsRejected", "mutationsTried"],
          "properties": {
            "status": { "enum": ["calibrated", "uncalibrated", "failed"] },
            "referencesAccepted": { "type": "integer", "minimum": 0 },
            "mutationsRejected": { "type": "integer", "minimum": 0 },
            "mutationsTried": { "type": "integer", "minimum": 0 },
            "trials": { "type": "array", "items": { "$ref": "#/$defs/ledgerRef" } }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "$ref": "#/$defs/digest" },
        "description": { "type": "string" }
      }
    }
  }
}
